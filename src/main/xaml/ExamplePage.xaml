<!--
  XAML-first Seed-Page. Quelle der Wahrheit fuer die UI, die .ui wird GENERIERT
  (XML-Kommentare verbieten Doppel-Minus, daher hier mit einem Minus notiert):

    xaml2ui src/main/xaml/ExamplePage.xaml \
        -o src/main/resources/Common/UI/Custom/Pages/MODNAME/ExamplePage.ui \
        -theme(2x Minus!) aether    oder: classic (Gold/Dark-Fantasy-Hauptlane)

  Nie die generierte .ui von Hand editieren, immer hier aendern + neu generieren.
  Subset-Doku: xaml2ui ohne Argumente | Beispiele: design/kurashi_lib/_xaml-experiment/
  Event-Handler landen in OUTPUT.events.java (addEventBinding-Snippets fuer
  InteractiveCustomUIPage.build): Snippets uebernehmen, Datei danach loeschen.
-->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hy="hytale" Width="520" Height="380">
  <Border Style="{StaticResource Frame}" Padding="20,16,20,16">
    <Border.Resources>
      <sys:String x:Key="PanelTitel" xmlns:sys="clr-namespace:System;assembly=mscorlib">Meine Mod</sys:String>
    </Border.Resources>
    <StackPanel>
      <TextBlock Style="{StaticResource TitleText}" Text="{StaticResource PanelTitel}" Height="30"/>
      <TextBlock Style="{StaticResource SubtleText}" Text="Untertitel oder Status" Height="18" Margin="0,4,0,0"/>
      <Separator Margin="0,12,0,0"/>

      <Border Style="{StaticResource Card}" Height="96" Padding="14,10,14,10" Margin="0,12,0,0">
        <StackPanel>
          <TextBlock Style="{StaticResource StatText}" Text="Beispielwert" Height="16"/>
          <TextBlock x:Name="ValueLabel" Style="{StaticResource ValueText}" Text="42" Height="22" Margin="0,4,0,0"/>
          <ProgressBar x:Name="ValueBar" Value="42" Maximum="100" Height="8" Margin="0,8,0,0"/>
        </StackPanel>
      </Border>

      <CheckBox x:Name="ToggleOption" Content="Option aktivieren" IsChecked="true" Margin="0,12,0,0" Toggled="OnToggleOption"/>

      <Grid ColumnDefinitions="*,10,*" Margin="0,16,0,0">
        <Button Grid.Column="0" x:Name="BtnAbbrechen" Style="{StaticResource GhostButton}" Content="Abbrechen" Height="40" Click="OnCancel"/>
        <Button Grid.Column="2" x:Name="BtnSpeichern" Style="{StaticResource PrimaryButton}" Content="Speichern" Height="40" Click="OnSave"/>
      </Grid>
    </StackPanel>
  </Border>
</Window>
